@article{OSTOJASTARZEWSKI199682,
title = {Spring network models in elasticity and fracture of composites and polycrystals},
journal = {Computational Materials Science},
volume = {7},
number = {1},
pages = {82-93},
year = {1996},
note = {Zeolites and related materials: Trends, targets and challenges},
